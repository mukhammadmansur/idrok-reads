# WBooks uses Node.js 24+ and local SQLite. No external account/API key is needed.
# These optional SERVER settings work without copying this template.
API_PORT=3001
HOST=127.0.0.1
WBOOKS_DB_PATH=./data/wbooks.db
# Local HTTP development uses 0. HTTPS deployments require 1.
# NODE_ENV=production also enables Secure cookies automatically.
WBOOKS_COOKIE_SECURE=0
# Never add passwords, GitHub tokens, private keys or session cookies here.
# No VITE_* credentials are needed. VITE_* values become public browser code.
# Optional browser-test override: CHROMIUM_PATH=/path/to/chromium
